# Both Python servers and Docker Compose load the repository-root .env.
# Environment variables override file values. Configure only the apps you run.
# Never commit credentials. Generate separate secrets with `openssl rand -hex 24`.

# Tournament
ADMIN_PASSWORD=
SESSION_SECRET=
APP_BASE_PATH=/jogo/
VITE_BASE_PATH=/jogo/
# Compose uses this for both the frontend build path and backend path.
TOURNAMENT_BASE_PATH=/jogo/
TRUST_PROXY=false
TRUSTED_PROXIES=127.0.0.1
# SESSION_COOKIE_SECURE=true

# Shifts
APP_NAME=Contínuos CRR
REGISTRATION_ENABLED=false
SECRET_KEY=
# Relative to apps/shifts/server/ for manual CLI runs; create data/shifts first.
# Local Make targets set an absolute root-data path; Compose uses its own volume.
DATABASE_URL=sqlite:///../../../data/shifts/bar_rota.db
BASE_URL=http://localhost:8000
ROOT_PATH=
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
# Required on the first start; do not use a placeholder password.
INITIAL_ADMIN_PASSWORD=
SESSION_HTTPS_ONLY=true
TIMEZONE=Europe/Lisbon
SCHEDULING_HORIZON_MONTHS=6
CALENDAR_TOKEN=
BACKUP_DIR=
REMINDER_DAYS_AHEAD=1

# Optional Shifts email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=bar-rota@example.com
SMTP_STARTTLS=true

# Optional Shifts Web Push; keep keys stable across deployments.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional Shifts door PINs; enable only after a supervised physical test.
TTLOCK_ENABLED=false
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
TTLOCK_USERNAME=
TTLOCK_PASSWORD=
TTLOCK_LOCK_ID=
TTLOCK_API_BASE_URL=https://euopen.ttlock.com
TTLOCK_ELIGIBLE_SCHEDULE_SLUGS=
TTLOCK_ENCRYPTION_KEY=
