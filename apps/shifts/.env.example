APP_NAME=Contínuos CRR
# Required, at least 32 random characters (e.g. `openssl rand -hex 24`).
# There is no default: a known key would let anyone forge an admin session.
SECRET_KEY=
DATABASE_URL=sqlite:///./data/bar_rota.db
BASE_URL=http://localhost:8000

# Behind a reverse proxy: the public address of the app, used in notification e-mails.
# ROOT_PATH is the prefix the proxy serves us under, e.g. /crr for https://host/crr/.
# Leave it empty when the app is at the root of the domain.
ROOT_PATH=
PORT=8000

# Monorepo Compose uses an independent shifts-data volume mounted at /data.
# DATABASE_URL above is the local-development path; Compose overrides it.

# Initial admin is created only if no teams exist (normally the first start).
# Required on that first start: bootstrap refuses an empty or placeholder password.
# The e-mail belongs to the user, so every notification for its teams lands here.
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me-now

# SMTP is optional. If SMTP_HOST is blank, notifications are recorded in the DB
# but no email is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=bar-rota@example.com
SMTP_STARTTLS=true

# Secret token of the shared whole-rota calendar feed (/calendar/<token>.ics).
# Leave empty and it is generated the first time an admin opens the schedules page.
CALENDAR_TOKEN=

# Timezone of the calendar feed. Times are published in this zone, so shifts show
# at the bar's own wall clock (Europe/Lisbon follows the European summer time).
TIMEZONE=Europe/Lisbon

# Where the startup backups of the SQLite file go. Empty means "backups" next to
# the database file. One copy per start, kept forever; names are never reused.
BACKUP_DIR=

# Reminder command looks this many days ahead.
REMINDER_DAYS_AHEAD=1

# How far ahead the rota may be scheduled, in whole months from the current one:
# the window runs from today through the end of the 6th month ahead (inclusive).
# Past and beyond-horizon dates stay visible but read-only.
SCHEDULING_HORIZON_MONTHS=6

# Secure session cookies are the default (localhost counts as secure in current
# browsers). Set false only when serving over plain HTTP, e.g. LAN development.
SESSION_HTTPS_ONLY=true
