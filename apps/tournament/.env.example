# Required. The app refuses to start without them: choose your own values,
# never deploy the placeholders an example once suggested.
ADMIN_PASSWORD=
SESSION_SECRET=
TRUST_PROXY=false
# With TRUST_PROXY=true, only these addresses may set X-Forwarded-* (comma-separated
# IPs or CIDRs). "*" would let any client spoof X-Forwarded-For and bypass the
# login rate limit.
TRUSTED_PROXIES=127.0.0.1
# SESSION_COOKIE_SECURE=true forces the Secure flag on the admin session cookie;
# unset it to decide per request (HTTPS or via the trusted proxy).
APP_BASE_PATH=/jogo/
VITE_BASE_PATH=/jogo/
